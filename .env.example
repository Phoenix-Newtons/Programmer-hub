# ---------------------------------------------------------------------
# Programmer's Hub — environment variables
# Copy this file to `.env.local` and fill in your own project.
# `.env.local` is git-ignored; these are the only two variables the app
# strictly needs (defaults already point at the public demo project).
# ---------------------------------------------------------------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://ggfukwknodeqwnitkjvk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------
# Optional flags
# ---------------------------------------------------------------------

# Start with fictional sample data turned on (default: off).
# Visitors can also flip this at runtime from the amber banner, the footer
# switch or the ⌘K palette — no rebuild required.
#   true  → read src/lib/demoData.js, show a "sample data" banner, disable saving
#   false → talk to Supabase
VITE_DEMO_DATA=false

# Absolute URL used for canonical links, sitemap entries and OG images.
# Leave empty for same-origin; set it when deploying (e.g. on Vercel).
# VITE_SITE_URL=https://programmers-hub.vercel.app

# Sub-path hosting (GitHub Pages): the CI workflow sets this automatically.
# VITE_BASE=/Programmer-hub/
