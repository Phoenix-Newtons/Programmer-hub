{
  "name": "programmers-hub",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Programmer's Hub — a modern developer marketplace to showcase skills, ship projects and get hired.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build && npm run check:build && npm run smoke",
    "assets:brand": "python3 scripts/generate-brand-assets.py",
    "format:check": "prettier --check .",
    "check:build": "node scripts/check-build.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "react",
    "vite",
    "tailwindcss",
    "supabase",
    "developer-marketplace"
  ],
  "license": "MIT"
}
