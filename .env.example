# ---------------------------------------------------------------------
# Programmer's Hub — environment variables
# Copy this file to `.env.local` and fill in your own project.
# `.env.local` is git-ignored; these are the only two variables the app
# strictly needs (defaults already point at the public demo project).
# ---------------------------------------------------------------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://ggfukwknodeqwnitkjvk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------
# Optional flags
# ---------------------------------------------------------------------

# Start with fictional sample data turned on (default: off).
# Visitors can also flip this at runtime from the amber banner, the footer
# switch or the ⌘K palette — no rebuild required.
#   true  → read src/lib/demoData.js, show a "sample data" banner, disable saving
#   false → talk to Supabase
VITE_DEMO_DATA=false

# Absolute URL used for canonical links, sitemap entries and OG images.
# Leave empty for same-origin; set it when deploying (e.g. on Vercel).
# NOTE: this must be the real deployment origin. It previously documented
# `programmers-hub.vercel.app`, which is not this project's production URL —
# copying it would have pointed every canonical/OG tag at someone else's host.
VITE_SITE_URL=https://programmer-hub-orcin.vercel.app

# ---------------------------------------------------------------------
# REQUIRED Supabase dashboard settings (not env vars — the console)
# ---------------------------------------------------------------------
# Supabase → Authentication → URL Configuration
#
#   Site URL:      https://programmer-hub-orcin.vercel.app
#   Redirect URLs: https://programmer-hub-orcin.vercel.app/**
#                  http://localhost:5173/**
#                  http://localhost:4173/**
#                  (+ every Vercel Preview origin you sign in from)
#
# If the live origin is missing from Redirect URLs, `signInWithOAuth()` still
# returns NO error — Supabase quietly substitutes the Site URL instead, and the
# visitor lands somewhere unexpected after Google. This is the single most
# common cause of "auth works on localhost but breaks in production", and no
# amount of client-side code can fix it. See docs/authentication.md.
#
# Google Cloud Console → OAuth client → Authorized redirect URI must be the
# SUPABASE callback (https://<project-ref>.supabase.co/auth/v1/callback),
# never the Vercel URL.

# Sub-path hosting (GitHub Pages): the CI workflow sets this automatically.
# VITE_BASE=/Programmer-hub/
