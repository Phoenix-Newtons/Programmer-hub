# ---------------------------------------------------------------------
# Optional flags
# ---------------------------------------------------------------------

# Two-factor authentication (TOTP MFA through Supabase) is required by
# default: after signing in with email + password, members are asked to add an
# authenticator app, and Supabase row level security refuses writes from a
# session that has not passed its second factor (see supabase/schema.sql).
#   true  → every account must verify a TOTP code before it can publish
#   false → 2FA is opt-in: it is offered in Dashboard → Security, and still
#           enforced for anyone who enrols
# VITE_REQUIRE_MFA=true

# Absolute URL used for canonical links, sitemap entries and OG images.
# Leave empty for same-origin; set it when deploying (e.g. on Vercel).
# VITE_SITE_URL=https://programmer-hub-orcin.vercel.app

# Sub-path hosting (GitHub Pages): the CI workflow sets this automatically.
# VITE_BASE=/Programmer-hub/

# --- Website preview proxy (optional) -----------------------------------
# Base URL of the preview reverse proxy (server/preview-proxy.mjs), which
# must run on its OWN origin/subdomain — never the app's origin. When set,
# the project viewer's iframe loads live demos through it so sites that
# send X-Frame-Options / CSP frame-ancestors can still be previewed.
# Leave empty to load demos directly (screenshot fallback covers blocks).
# VITE_PREVIEW_PROXY_URL=https://preview.example.com
#
# Proxy server settings (read by `npm run proxy`, not Vite):
# PORT=8787
# PROXY_ALLOWED_HOSTS=example.com,*.vercel.app,*.netlify.app,*.github.io
# PROXY_FRAME_ANCESTORS='self' https://programmer-hub-orcin.vercel.app
# PROXY_ALLOW_PRIVATE=true   # local development only — never in production

# --- Headless-Chrome snapshots (server/preview-proxy.mjs /api/preview) --
# Browser binary for puppeteer-core, or run `npm install puppeteer` and
# leave this unset. Without a browser, /api/preview returns 503 with
# setup instructions.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# PREVIEW_MAX_CONCURRENCY=3
# PREVIEW_TIMEOUT_MS=30000
# PREVIEW_SETTLE_MS=1500
# PREVIEW_BROWSER_PER_REQUEST=false
