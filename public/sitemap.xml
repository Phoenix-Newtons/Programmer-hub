<?xml version="1.0" encoding="UTF-8"?>
<!--
  Public routes only. `/shortlist`, `/dashboard` and `/login` are private
  (they ship `<meta name="robots" content="noindex">`) and are deliberately
  excluded here.

  Vite rewrites these <loc> values to absolute URLs and adds <lastmod>
  at build time when VITE_SITE_URL (or VITE_BASE) is configured — see vite.config.js.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/developers</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>/projects</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>/hiring</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
