# ---------------------------------------------------------------------
# Programmer's Hub — environment variables
# Copy this file to `.env.local` and fill in your own project.
# `.env.local` is git-ignored; these are the only two variables the app
# strictly needs (defaults already point at the public project).
# ---------------------------------------------------------------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://ggfukwknodeqwnitkjvk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------
# Optional flags
# ---------------------------------------------------------------------

# Two-factor authentication (TOTP MFA through Supabase) is required by
# default: after signing in with email + password, members are asked to add an
# authenticator app, and Supabase row level security refuses writes from a
# session that has not passed its second factor (see supabase/schema.sql).
#   true  → every account must verify a TOTP code before it can publish
#   false → 2FA is opt-in: it is offered in Dashboard → Security, and still
#           enforced for anyone who enrols
# VITE_REQUIRE_MFA=true

# Absolute URL used for canonical links, sitemap entries and OG images.
# Leave empty for same-origin; set it when deploying (e.g. on Vercel).
# VITE_SITE_URL=https://programmers-hub.vercel.app

# Sub-path hosting (GitHub Pages): the CI workflow sets this automatically.
# VITE_BASE=/Programmer-hub/
